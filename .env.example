# ==========================================
# GintiSaathi - Environment Configuration
# ==========================================

# Server-Side Gemini API Key (Never exposed to client)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (defaults to 3001)
PORT=3001

# Frontend Vite Port (defaults to 5173)
VITE_PORT=5173

# Optional: Firebase Web SDK Configuration
# The app works in 100% full offline / local mock mode if left empty!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
